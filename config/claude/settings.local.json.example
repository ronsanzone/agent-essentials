{
  "_comment": "Machine-local settings. Copy to ~/.claude/settings.local.json (never symlinked, never committed). Absolute paths and host-specific hooks belong here, not in settings.json.",
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": []
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/ron.sanzone/skills/tldraw-offline/inject-server-context.sh' SubagentStart"
          }
        ]
      }
    ]
  }
}
